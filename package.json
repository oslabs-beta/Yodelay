{
  "name": "yodelay",
  "version": "1.0.0",
  "description": "Browser client for trying gRPC servers locally.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "concurrently -k \"npm run dev:web\" \"npm run dev:proxy\" \"npm run dev:grpc\"",
    "dev:web": "vite",
    "dev:proxy": "node server_client/server_client.js",
    "dev:grpc": "node grpc_server/demo.js",
    "test": "node --test ./test/*.test.js",
    "audit:ci": "npm audit --audit-level=moderate"
  },
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "ace-builds": "^1.39.0",
    "concurrently": "^9.2.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-ace": "^14.0.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "sass": "^1.89.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
